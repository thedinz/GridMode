{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GridMode",
  "version": "1.0.0",
  "identifier": "com.thedinz.gridmode",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm vite --host 127.0.0.1",
    "beforeBuildCommand": "pnpm build:renderer"
  },
  "app": {
    "windows": [
      {
        "title": "GridMode",
        "width": 1320,
        "height": 920,
        "minWidth": 840,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' gridmode-photo: http://gridmode-photo.localhost; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "thedinz",
    "homepage": "https://github.com/thedinz/GridMode",
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2QkQ3QUQ4NkUxNzFGN0IKUldSN0h4ZHUySHE5RnV3Wk5rS1YwQnk5eFZjblFabmc1WVdHUWNYcXlqZDNldHZvdXlqRTRqMVkK",
      "endpoints": [
        "https://github.com/thedinz/GridMode/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
